{
  "name": "shelltab",
  "version": "1.9.0",
  "description": "Tabbed terminal with native SSH, an SFTP browser, FTP and timed nudges",
  "main": "main.js",
  "scripts": {
    "build:renderer": "cp node_modules/@xterm/xterm/css/xterm.css renderer/xterm.css && esbuild renderer/app.js --bundle --outfile=renderer/bundle.js --platform=browser --format=iife",
    "start": "npm run build:renderer && electron .",
    "rebuild": "electron-rebuild",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "dist:all": "npm run build:renderer && electron-builder --win --linux",
    "publish:lan": "npm run dist:win && install -m 644 -D dist/latest.yml dist/ShellTab-Setup-$npm_package_version.exe dist/ShellTab-Setup-$npm_package_version.exe.blockmap -t /var/www/html/shelltab/",
    "smoketest": "npm run build:renderer && SHELLTAB_SELFTEST=1 xvfb-run -a electron . --no-sandbox --user-data-dir=\"${TMPDIR:-/tmp}/shelltab-smoketest-$$\""
  },
  "build": {
    "appId": "com.shelltab.app",
    "productName": "ShellTab",
    "files": [
      "main.js",
      "preload.js",
      "sshmanager.js",
      "updater.js",
      "keepalive.js",
      "renderer/**/*",
      "!renderer/app.js",
      "!renderer/sftp.js",
      "!renderer/shellint.js",
      "!renderer/dialogs.js",
      "node_modules/**/*",
      "!node_modules/cpu-features/**/*",
      "!node_modules/nan/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "TerminalEmulator",
      "icon": "icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://10.0.2.158/shelltab/"
      }
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "basic-ftp": "^5.0.5",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.28.0"
  }
}
